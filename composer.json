{
    "name": "bitesizedinsights/global-news-scraper",
    "description": "Global news scraper PHP client: full-text articles from 300+ news sources via Apify, merged into typed DTOs.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "global news scraper",
        "news scraper",
        "news api",
        "news aggregator",
        "article extraction",
        "full text articles",
        "news data",
        "sentiment analysis",
        "php",
        "apify",
        "api client",
        "laravel collections"
    ],
    "homepage": "https://github.com/bitesizedinsights/global-news-scraper-php",
    "support": {
        "issues": "https://github.com/bitesizedinsights/global-news-scraper-php/issues",
        "source": "https://github.com/bitesizedinsights/global-news-scraper-php"
    },
    "authors": [
        {
            "name": "bite-sized-insights",
            "homepage": "https://apify.com/bite-sized-insights"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.0 || ^8.0",
        "illuminate/collections": "^11.0 || ^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "GlobalNewsScraper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlobalNewsScraper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "cs": "pint --test",
        "cs:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
